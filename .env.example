# Copia este archivo a .env y rellena lo que necesites, o ejecuta `python setup.py --init`
# para que te lo pregunte campo a campo (Enter acepta el valor por defecto que ves aquí).
# Docker Compose lo carga automáticamente si se llama ".env".

# Opcional. Si lo dejas vacío, cada agente pi no recibirá ninguna API key por entorno:
# la primera vez que te conectes a su sesión tmux (ver README del compose) haces /login
# interactivamente y eliges el proveedor que quieras. La sesión/credenciales quedan
# persistidas en el volumen de cada agente (/root/.pi/agent), así que el login solo
# hace falta una vez por contenedor.
ANTHROPIC_API_KEY=

# Prefijo usado para nombrar los 5 contenedores (por defecto pi-manager, pi-backend, ...).
# Cámbialo si quieres levantar varias instancias de este proyecto en la misma máquina sin
# que choquen los nombres de contenedor.
CONTAINER_PREFIX=pi

# URL del remote git (origin) del repositorio real de cada rol — de ahí es de donde ese
# agente clona/hace pull-push del código sobre su /workspace. Formato SSH o HTTPS, por
# ejemplo: git@ssh.dev.azure.com:v3/<org>/<proyecto>/<repo> o https://dev.azure.com/<org>/<proyecto>/_git/<repo>.
# Vacío mientras el stack/repos de cada rol siga por decidir.
MANAGER_REPO_URL=
BACKEND_REPO_URL=
FRONTEND_REPO_URL=
DEVOPS_REPO_URL=
CYPRESS_REPO_URL=

# Token de acceso (PAT) para el REPO_URL de ese mismo rol cuando esté en formato https://.
# Recomendado: un token con el mínimo alcance posible — scope de solo ese repo (fine-grained
# PAT de GitHub) o, en Azure DevOps, un PAT con scope "Code: Read & Write" nada más. Nunca se
# escribe en la URL del remoto ni en .git/config: entrypoint.sh configura un credential
# helper de git que lo lee de esta variable de entorno en el momento de autenticar. Si para
# algún rol prefieres SSH en vez de HTTPS, deja esta variable vacía, pon el REPO_URL en
# formato git@... y configura esa clave manualmente en el contenedor — este token no interfiere.
MANAGER_GIT_TOKEN=
BACKEND_GIT_TOKEN=
FRONTEND_GIT_TOKEN=
DEVOPS_GIT_TOKEN=
CYPRESS_GIT_TOKEN=

# Organización y proyecto de Azure DevOps compartidos por todo el equipo (única fuente de
# verdad del workflow, ver docs/work-procedures.md). Se exponen dentro de cada contenedor
# como variables de entorno, listas para usar con:
#   az devops configure --defaults organization=$ADO_ORGANIZATION_URL project=$ADO_PROJECT
ADO_ORGANIZATION_URL=https://dev.azure.com/<tu-organizacion>
ADO_PROJECT=<tu-proyecto>
