# Secretos / configuración local — nunca subir
.env

# Estado local de Claude Code
.claude/settings.local.json

# Carpeta workspace/ ya no existe en este repo: el código de cada rol vive en un volumen
# Docker nombrado (<rol>-workspace, ver docker-compose.yml), no en un bind mount a una carpeta
# de este repositorio — así /workspace dentro de cada contenedor nace siempre vacío y nunca
# hay artefactos de mount-point que versionar por accidente.

# Datos reales de coste de cada agente (pi-cost-counter, ver docker-compose.yml) — cambian en
# cada ejecución, no son código.
cost-tracking/*/*
!cost-tracking/*/.gitkeep
